# justfile for {{crate_name}}

# Cargo build profile.
cargo_profile := "dev"
# Pocketbook SDK version. Either "5.19", "6.5", "6.8", "6.10"
pb_sdk_version := "6.10"
# Pocketbook device identifier as it's folder name when connected with USB.
# - Pocketbook Inkpad 4: "6678-3C5A"
# - Pocketbook Touch Lux 3: "PB626"
# - Pocketbook Touch 3 HD: "PB632"
pb_device := "PB632"
# Pocketbook's ssh username
pb_ssh_user := "reader"
# Pocketbook's IP address
pb_ssh_ip := "192.168.1.27"
# Pocketbook's openned port that accepts ssh connection
pb_ssh_port := "2222"
# Pocketbook's target directory, where the deployed app via SSH would land
pb_target_app_dir := "/mnt/ext1/applications"
# Pocketbook's application name your binary is going to be deployed as
pb_target_app_name := "{{crate_name}}.app"

[private]
binary := "{{crate_name}}"
[private]
pb_mount_root := if os() == "macos" { "/Volumes" } else { "/run/media/$USER" }
[private]
cargo_sdk_feature := "sdk-" + replace(pb_sdk_version, ".", "-")
[private]
build_target := "armv7-unknown-linux-gnueabi"
[private]
zigbuild_target := "armv7-unknown-linux-gnueabi.2.23"
[private]
cargo_out_profile := if cargo_profile == "dev" { "debug" } else { cargo_profile }

{% raw %}
default:
    just --list

[doc("""
build the application.
command examples:
1. `just build` -- it would take the default cargo_profile
2. `just cargo_profile=release build`
3. `just pb_sdk_version=6.5 build`
""")]
build:
    # The SDK features are mutually exclusive, so the default one must be turned
    # off before selecting another. Raising the descriptor limit keeps debug
    # builds of the slint variant working on macOS.
    ulimit -n 4096 2>/dev/null || true; \
    cargo zigbuild \
        --target {{ zigbuild_target }} \
        --profile {{ cargo_profile }} \
        --no-default-features \
        --features={{ cargo_sdk_feature }} \
        --bin {{ binary }}
[doc("""
Transfer a built binary to the device via USB.
Command examples:
1. `just deploy-usb`
2. `just cargo_profile=release pb_device=POCKETBOOK pb_app_name="inkview-slint-demo.app" deploy-usb`
""")]
deploy-usb:
    # 1. Copying the binary to the device
    cp "target/{{ build_target / cargo_out_profile / binary }}" \
        "{{ pb_mount_root / pb_device / 'applications' / pb_target_app_name }}"
    # 2. Cleaning up macOS metadata files (if applicable)
    {{ if os() == "macos" { "dot_clean " + (pb_mount_root / pb_device / "applications") } else { "echo 'No cleanup needed'" } }}
    # 3. Flushing the filesytem cache
    sync {{ pb_mount_root / pb_device }}
    @echo "Deployment successful!"

[doc("""
Transfer a built binary to the device via SSH.
Command examples:
1. `just deploy-ssh`
2. `just cargo_profile=release deploy-ssh`
3. `just cargo_profile=release pb_user="root" pb_app_name="test.app" deploy-ssh`
""")]
deploy-ssh:
    @echo "Sending application '{{ binary }}' .."
    scp -O -P {{ pb_ssh_port }} -o HostKeyAlgorithms=+ssh-rsa \
        {{ "target" / build_target / cargo_out_profile / binary }} \
        "{{ pb_ssh_user }}@{{ pb_ssh_ip }}:'{{ pb_target_app_dir }}/{{ pb_target_app_name }}.stage'"

    @echo "Restarting application on target..."
    ssh -p {{ pb_ssh_port }} -o HostKeyAlgorithms=+ssh-rsa {{ pb_ssh_user }}@{{ pb_ssh_ip }} \
        "sh -c \"killall '{{ pb_target_app_name }}'; mv '{{ pb_target_app_dir }}/{{ pb_target_app_name }}.stage' '{{ pb_target_app_dir }}/{{ pb_target_app_name }}'; '{{ pb_target_app_dir }}/{{ pb_target_app_name }}'\""

build-deploy-usb: build deploy-usb

build-deploy-ssh: build deploy-ssh

# --- Desktop emulator -------------------------------------------------------
# Run the app on this machine instead of the device: the SDK ships a host x86_64
# build of libinkview, and inkview loads its library by name at runtime.
#
# The tooling itself lives in a separate project, shared by every inkview-rs
# app, so it can be updated without regenerating yours:
#
#     git clone https://github.com/ihrfv/inkview-rs-emu ~/tools/inkview-rs-emu
#     export PATH="$HOME/tools/inkview-rs-emu:$PATH"
#
# See its README for the SDK matrix, driving the app with tap/swipe/key input,
# and the firmware-level emulator to escalate to.

# SDK version the emulator uses -- "6.8" or "6.10". Independent of
# pb_sdk_version: this only picks which host libinkview the desktop build runs
# against.
pb_emu_sdk_version := "6.10"
# Device the emulator presents. Must match a hwconfig_<device> in the cached
# system/ tree ("inkview-emu shell" can list them).
pb_emu_device := "632"
# Screen geometry the emulator uses (inkview's `emu_resmode`). Known values:
#   0      = emulator default    1, 6 = 758x1024     2 = 768x1024
#   3      = 828x1200            4, 5 = 1200x1600    7 = 480x800
#   8,9,10 = 1072x1448          11,12 = 1404x1872
# 8 matches the 632 (Touch HD 3) default above, which is what `screenshot-emu`
# wants. X11 does not scale the window, though, so 1448 rows overflow a typical
# laptop screen: for `run-emu` pass a smaller mode, e.g. `pb_emu_resmode=3`.
pb_emu_resmode := "8"

[private]
emu_env := "PB_EMU_SDK_VERSION=" + pb_emu_sdk_version + \
    " PB_EMU_DEVICE=" + pb_emu_device + \
    " PB_EMU_RESMODE=" + pb_emu_resmode + \
    " CARGO_PROFILE=" + cargo_profile

# Fail with something actionable rather than "command not found" in the middle
# of a docker invocation.
[private]
_require-emu:
    #!/usr/bin/env bash
    command -v inkview-emu >/dev/null && exit 0
    echo "inkview-emu is not on PATH. Install it with:" >&2
    echo "  git clone https://github.com/ihrfv/inkview-rs-emu ~/tools/inkview-rs-emu" >&2
    echo "  export PATH=\"\$HOME/tools/inkview-rs-emu:\$PATH\"" >&2
    exit 1

# One-time: fetch the SDK host subtree and runtime system/ tree into
# ~/.cache/inkview-emu, where every project on this machine shares them.
fetch-emu-assets: _require-emu
    {{ emu_env }} inkview-emu fetch-assets

# Build the emulator's runtime container image (one-time, per SDK version).
emu-image: _require-emu
    {{ emu_env }} inkview-emu image

# Build the application for the desktop emulator (host x86_64 linux).
build-emu: _require-emu
    {{ emu_env }} inkview-emu build {{ binary }}

[doc("""
Run the application in the SDK emulator, in a window on this machine.
Needs an X server: XQuartz on macOS (configured for you), the local display
elsewhere. The window is `pb_emu_resmode` pixels large and X11 will not scale
it, so pass a smaller mode to see all of it:
`just pb_emu_resmode=3 run-emu`   # 828x1200
Command example: `just run-emu`
""")]
run-emu *args: _require-emu
    {{ emu_env }} inkview-emu run {{ binary }} {{ args }}

[doc("""
Run the application in the emulator against a throwaway X server and save the
first frame to "target/emu/screenshot.png". Needs no X server on this machine,
so it also works in CI.
Command example: `just screenshot-emu`
""")]
screenshot-emu *args: _require-emu
    {{ emu_env }} inkview-emu shot {{ binary }} {{ args }}

# Open a shell in the emulator container (ldd, readelf, xdpyinfo).
emu-shell: _require-emu
    {{ emu_env }} inkview-emu shell

build-run-emu: build-emu run-emu

build-screenshot-emu: build-emu screenshot-emu


 {% endraw %}
